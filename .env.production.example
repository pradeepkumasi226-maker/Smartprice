# ==============================================================================
# SmartPrice Explainable AI Retail Optimization Suite v3.0.0
# Production Environment Configuration Template (.env.production.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (or 'backend/.env') in your production deployment.
# 2. Replace all placeholder values with verified production secrets.
# 3. Ensure this file has restricted permissions (chmod 600 or Windows restricted ACL).
# 4. NEVER commit production .env files containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Mandatory: Must be set to 'production' to enforce strict security policies:
# - Disables /docs, /redoc, /openapi.json Swagger documentation.
# - Sanitizes internal server exception messages.
# - Enforces high-entropy JWT secrets (>= 32 characters).
# - Suppresses development OTPs and recovery tokens from API responses.
ENVIRONMENT=production
PROJECT_NAME="SmartPrice Explainable AI Retail Engine"
PORT=8000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: Relative or absolute path to production SQLite database.
# Note: Ensure directory permissions allow write access for WAL journal files.
DATABASE_URL=sqlite:///backend/data/smartprice.db

# ------------------------------------------------------------------------------
# CORS & FRONTEND ORIGINS
# ------------------------------------------------------------------------------
# Primary URL where the frontend web application is hosted:
FRONTEND_URL=https://smartprice.example.com

# Additional trusted origins allowed to make cross-origin API requests (comma-separated):
# ALLOWED_ORIGINS=https://smartprice.example.com,https://admin.smartprice.example.com
ALLOWED_ORIGINS=https://smartprice.example.com

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC KEYS & JWT SECURITY (MANDATORY >= 32 CHARACTERS)
# ------------------------------------------------------------------------------
# Generation Command Options:
#   Python:     python -c "import secrets; print(secrets.token_hex(32))"
#   OpenSSL:    openssl rand -hex 32
#   PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
#
# FATAL: Startup will deliberately fail if JWT_SECRET_KEY is empty, shorter than
# 32 characters, or identical to the default development key.
SESSION_SECRET=REPLACE_WITH_HIGH_ENTROPY_HEX_SECRET_AT_LEAST_32_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_HEX_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# AUTHENTICATION BRUTE-FORCE RATE LIMITING
# ------------------------------------------------------------------------------
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# RECOVERY & OTP SECURITY SETTINGS
# ------------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# EMAIL (SMTP) NOTIFICATION SERVICE
# ------------------------------------------------------------------------------
# Required for production password recovery and verification emails:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=production-alerts@example.com
SMTP_APP_PASSWORD=your-secure-smtp-app-password
SMTP_FROM_EMAIL=noreply@example.com

# ------------------------------------------------------------------------------
# SMS NOTIFICATION SERVICE (OPTIONAL)
# ------------------------------------------------------------------------------
# Options: "fast2sms", "twilio", "msg91", "custom", "mock"
SMS_PROVIDER=mock
FAST2SMS_API_KEY=YOUR_PRODUCTION_FAST2SMS_API_KEY_HERE
# TWILIO_ACCOUNT_SID=YOUR_PRODUCTION_TWILIO_SID
# TWILIO_AUTH_TOKEN=YOUR_PRODUCTION_TWILIO_AUTH_TOKEN
# TWILIO_PHONE_NUMBER=+1234567890

