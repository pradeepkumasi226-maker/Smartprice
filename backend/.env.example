# SmartPrice Server & Database Configuration
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=smartprice-local-dev-secret-key-2026
ENVIRONMENT=development
PORT=8000
# Production Security: Supply persistent, high-entropy secret in production (>= 32 chars)
# JWT_SECRET_KEY=YOUR_PRODUCTION_HIGH_ENTROPY_JWT_SECRET_KEY_HERE_MIN_32_CHARS

# ====================================================
# REAL SMS PROVIDER CONFIGURATION
# ====================================================
# Options: "fast2sms", "twilio", "msg91", "custom", "mock"
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=PASTE_REAL_API_KEY_HERE
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Optional Fallback / Alternative Gateway Aliases
SMS_API_KEY=
SMS_SENDER_ID=SMPRCE
